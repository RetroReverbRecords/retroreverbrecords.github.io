<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Article", "headline": "Why I gave up my label's cut: eight years in synthwave", "description": "Founder Cole Bouchard (Cybertronix) on why Retro Reverb Records gave up its label cut.", "datePublished": "2026-10-26", "dateModified": "2026-10-26", "author": {"@type": "Person", "name": "Cole Bouchard (Cybertronix)"}, "publisher": {"@type": "Organization", "name": "Retro Reverb Records", "url": "https://retroreverbrecords.com/", "logo": {"@type": "ImageObject", "url": "https://retroreverbrecords.com/assets/icon-512.png"}}, "image": "https://retroreverbrecords.com/assets/og-image.jpg", "mainEntityOfPage": "https://retroreverbrecords.com/story.html"}</script>
